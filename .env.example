APP_NAME=NexusAI
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true

# CORS configuration (comma-separated list of allowed browser origins)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

LLM_PROVIDER=mock
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_TEMPERATURE=0.0
LLM_RELEVANCE_THRESHOLD=0.4
LLM_HIGH_CONFIDENCE_THRESHOLD=0.6
MAX_UPLOAD_SIZE=10485760
UPLOAD_DIR=data/raw
CHUNK_SIZE=500
CHUNK_OVERLAP=50
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_STORE_DIR=data/vector_store
LOGS_DIR=logs
LOG_QUERY_PREVIEWS=false
EVALUATOR_PROVIDER=mock
EVALUATOR_MODEL=gpt-4o-mini

# Gemini LLM Judge configuration (optional)
GEMINI_API_KEY=
GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions

# Quality Benchmark settings (supported providers: mock, openai, gemini)
# EVAL_QUALITY_PROVIDER=gemini
# EVAL_QUALITY_MODEL=gemini-2.5-flash
# EVAL_QUALITY_RPM_LIMIT=15
